{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "includeFiles": "{app.py,backend/**,gemini_verification_fixtures.json,frontend/**,templates/**}",
      "excludeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!media/).*)",
      "destination": "/api/index"
    }
  ],
  "regions": [
    "sin1"
  ],
  "buildCommand": "python3 tools/validate_cloud_environment.py"
}
