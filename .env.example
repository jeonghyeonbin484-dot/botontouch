# 서버에만 설정합니다. 실제 키/운영 DB/직원정보를 넣지 마세요.
# Vercel Marketplace에서 별도 Neon 테스트 DB 연결 후 자동 설정된 값을 사용합니다.
DATABASE_URL=
# 테스트 계정 전용 무작위 비밀번호(16자 이상). 저장소에 실제 값을 커밋하지 마세요.
BATON_DEMO_PASSWORD=
BATON_PUBLIC_ORIGIN=
# 기본값은 MOCK. 실제 운영자료 승인은 이 설정으로 대체할 수 없습니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
BATON_STAFF_AI_MODE=mock
BATON_STAFF_FICTIONAL_ALLOWED=false
# 실제 가상자료 테스트를 허용할 서버 검증 계정만 지정합니다.
BATON_STAFF_AI_TEST_USERS=
# 내부 조직도 실제 연결은 공개 사이트에서 사용하지 않습니다.
